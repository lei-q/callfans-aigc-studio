#!/bin/sh
# AIGC 创作台 · 无界面 Web 服务（适合没有桌面环境的 Linux 服务器）
#   aigc-studio-web [--port 5780] [--lan] [--data <目录>]
# 用程序自带的 Electron 以 Node 方式运行内置服务，不需要另外安装 Node.js。
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
RES="$(cd "$(dirname "$SELF")/.." && pwd)"
APP="$(cd "$RES/.." && pwd)"
BIN="$APP/aigc-studio"
[ -x "$BIN" ] || BIN="$(ls "$APP"/AIGC* 2>/dev/null | head -n 1)"
ELECTRON_RUN_AS_NODE=1 exec "$BIN" "$RES/server/server.cjs" "$@"
